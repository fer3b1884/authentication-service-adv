SERVER_PORT=8081
DOCKER_HOST_PORT=8081

JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

DB_NAME=authentication-service-adv
DB_URL=jdbc:postgresql://localhost:5432/${DB_NAME}
DB_USERNAME=postgres
DB_PASSWORD=local_db_password

JWT_SECRET=base64_encoded_local_jwt_secret

INTERNAL_SERVICE_SECRET=local_internal_service_secret

DOCKER_DB_NAME=authentication-service-adv
DOCKER_DB_URL=jdbc:postgresql://postgres:5432/${DOCKER_DB_NAME}
DOCKER_DB_USERNAME=postgres
DOCKER_DB_PASSWORD=docker_db_password

DOCKER_JWT_SECRET=base64_encoded_docker_jwt_secret

DOCKER_INTERNAL_SERVICE_SECRET=docker_internal_service_secret

ADMIN_USER_ID=1
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin_password